# Copy to .env and fill in real values. Never commit the real file (it is
# gitignored); .env.example only ever holds placeholders.

# Required for LEAD_PROVIDERS=openai (the default). Not required for
# LEAD_PROVIDERS=fake.
OPENAI_API_KEY=sk-placeholder

ENV=development
LEAD_PROVIDERS=openai

TRANSCRIBE_MODEL=gpt-transcribe
EXTRACT_MODEL=gpt-6-luna

PORT=8000

MAX_UPLOAD_BYTES=26214400
MAX_TRANSCRIPT_CHARS=4000
MIN_WORDS_FOR_EXTRACTION=3

RATE_LIMIT_PER_IP=3
RATE_LIMIT_WINDOW_SECONDS=60
DAILY_CALL_BUDGET=1000

# Unset (leave blank) to disable cost estimates. Check the live pricing
# page for the models configured above before setting these.
PRICE_PER_INPUT_TOKEN=
PRICE_PER_OUTPUT_TOKEN=
PRICE_PER_AUDIO_SECOND=
